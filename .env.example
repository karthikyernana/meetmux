# PlanGuard Environment Configuration
# Copy this to .env and fill in real values

# ── App Database ─────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg://planguard:planguard@localhost:5432/planguard

# ── Queue ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Security ──────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets, base64; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
APP_ENCRYPTION_KEY=CHANGE_ME_32_BYTE_BASE64_KEY_XXXX

ALLOWED_ORIGINS=http://localhost:5173

# ── AI Features (optional) ────────────────────────────────────────────────────
LLM_ENABLED=false
GEMINI_API_KEY=

JEV_ENABLED=false
TYPESAFE_API_KEY=

# ── Analysis Limits ───────────────────────────────────────────────────────────
MAX_CANDIDATES_PER_QUERY=8
MAX_INDEX_COLUMNS=3
ANALYSIS_STATEMENT_TIMEOUT_MS=30000

# ── Development ───────────────────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=false
